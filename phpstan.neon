includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 5

    ignoreErrors:
        - '#Access to an undefined property App\\Models\\Transaction::\$.*#'
        - '#Method .* should return .* but returns .*#'
        - '#Parameter .* contains unresolvable type#'
